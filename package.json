{
  "name": "poker-softa",
  "version": "1.28.6",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm -w shared run build",
    "build:client": "npm -w client run build",
    "build:server": "npm -w server run build",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:vercel": "npm run build:shared && npm run build:client",
    "build:railway": "npm run build:shared && npm run build:server",
    "dev": "concurrently -k \"npm -w server run dev\" \"npm -w client run dev\"",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:container": "bash scripts/test-container.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
